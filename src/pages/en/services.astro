---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Our Services – Guzman Tax Accounting Las Vegas" description="Professional tax, bookkeeping, payroll, LLC and more. Bilingual staff in Las Vegas, Nevada." lang="en" langHref="/servicios">
<section class="page-hero"><div class="container"><div class="breadcrumb"><a href="/en/">Home</a> <span>›</span> <span>Services</span></div><h1>Our Services</h1><p>Bilingual Accounting Firm in Las Vegas: complete solutions for individuals and businesses.</p></div></section>
<section class="section"><div class="container">
  <div class="section-header text-center">
    <p class="eyebrow">Special Promotion</p>
    <h2>Free Website When You Form Your LLC</h2>
    <p>Free 1-page website when you form an LLC or hire any of our professional services. Hosting included at no extra cost. Consultations for new clients, no commitment.</p>
  </div>
  <div class="services-grid" style="margin-bottom:60px;">
    <div class="service-card"><div class="service-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V9z"/><path d="M14 3v6h6"/></svg></div><h3>Tax Preparation</h3><ul><li>1040, LLC, S-Corp, C-Corp</li><li>Tax credits: EIC, Child Tax Credit</li><li>Itemized returns and dependents</li><li>State and federal compliance</li></ul></div>
    <div class="service-card"><div class="service-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="20" x2="20" y2="20"/><line x1="7" y1="20" x2="7" y2="14"/><line x1="12" y1="20" x2="12" y2="9"/><line x1="17" y1="20" x2="17" y2="4"/></svg></div><h3>Bookkeeping</h3><ul><li>Monthly reconciliation</li><li>Organized accounting records</li><li>Clear financial statements</li></ul></div>
    <div class="service-card"><div class="service-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5"/><path d="M4 20c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg></div><h3>Payroll Services</h3><ul><li>Direct deposit</li><li>Federal and state payroll taxes</li><li>W-2 and 1099 forms</li></ul></div>
    <div class="service-card"><div class="service-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L20.5 7v10L12 22 3.5 17V7z"/></svg></div><h3>LLC Formation & Business</h3><ul><li>LLC, S-Corp, C-Corp</li><li>EIN registration</li><li>Operating agreement and state compliance</li></ul></div>
    <div class="service-card"><div class="service-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="13" rx="1"/><path d="M3 7l9 7 9-7"/></svg></div><h3>IRS Letters & Compliance</h3><ul><li>IRS letter response</li><li>Audits</li><li>Tax compliance support</li></ul></div>
    <div class="service-card"><div class="service-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/></svg></div><h3>Retirement Planning</h3><ul><li>401(k), IRA and SEP IRA plans</li><li>Tax-efficient strategies</li><li>For self-employed and businesses</li></ul></div>
    <div class="service-card"><div class="service-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/></svg></div><h3>Business Consulting</h3><ul><li>Financial projections and budgeting</li><li>Growth strategy</li><li>Startup advisory</li></ul></div>
    <div class="service-card"><div class="service-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="14" rx="1"/><line x1="2" y1="8" x2="22" y2="8"/><line x1="8" y1="22" x2="16" y2="22"/><line x1="12" y1="18" x2="12" y2="22"/></svg></div><h3>Web Design & Marketing</h3><ul><li>Free website when you form your LLC</li><li>Online stores: Amazon, eBay, Etsy</li><li>Local SEO and Google/Meta Ads</li></ul></div>
  </div>
  <div class="cta-section" style="border-radius:16px;"><h2>Have Questions?</h2><p>Schedule a consultation and we will explain everything with no commitment.</p><div class="btn-group"><a href="/en/consultation" class="btn btn-primary">Consultation</a><a href="tel:+17253406758" class="btn btn-white">Call Now</a></div></div>
</div></section>
</Layout>
