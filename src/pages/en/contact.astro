---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Contact – Guzman Tax Accounting Las Vegas" description="Contact us for tax and accounting services in Las Vegas. Bilingual service available." lang="en" langHref="/contacto">
<section class="page-hero"><div class="container"><div class="breadcrumb"><a href="/en/">Home</a> <span>›</span> <span>Contact</span></div><h1>Contact Us</h1><p>Bilingual service available. Call or write to us.</p></div></section>
<section class="section"><div class="container"><div class="contact-grid">
  <div class="contact-info"><p class="eyebrow">We Are Here</p><h2>Talk to Us</h2><p>English and Spanish service available. Do not hesitate to contact us however you prefer.</p>
    <div class="contact-detail"><div class="contact-detail-icon"><span class="svg-icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-8-7.5-8-12a8 8 0 0 1 16 0c0 4.5-8 12-8 12z"/><circle cx="12" cy="9" r="3"/></svg></span></div><div class="contact-detail-text"><h4>Address</h4><p>4760 S Pecos Rd Suite 103-20<br/>Las Vegas, Nevada 89121</p></div></div>
    <div class="contact-detail"><div class="contact-detail-icon"><span class="svg-icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.18h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.77a16 16 0 0 0 6 6l1.92-1.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span></div><div class="contact-detail-text"><h4>Phone / WhatsApp</h4><p><a href="tel:+17253406758">(725) 340-6758</a></p></div></div>
    <div class="contact-detail"><div class="contact-detail-icon"><span class="svg-icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="2 4 12 13 22 4"/></svg></span></div><div class="contact-detail-text"><h4>Email</h4><p><a href="mailto:info@guzmantaxaccounting.com">info@guzmantaxaccounting.com</a></p></div></div>
    <div class="contact-detail"><div class="contact-detail-icon"><span class="svg-icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span></div><div class="contact-detail-text"><h4>Hours</h4><p>Sunday – Friday: 9 AM – 7 PM</p></div></div>
    <div style="margin-top:28px;padding:16px;background:var(--gray);border-radius:10px;font-size:.85rem;color:var(--text-light);"><strong>Notice:</strong> Guzman Tax Accounting & Multi Services is not currently licensed as a CPA firm in the state of Nevada. We offer tax preparation, bookkeeping and consulting services based on professional experience.</div>
  </div>
  <div><div class="form-card"><h3 style="margin-bottom:6px;">Send Us a Message</h3><p style="color:var(--text-light);font-size:.9rem;margin-bottom:24px;">We will respond within 24 hours.</p>
    <form id="contact-form">
      <div class="form-row"><div class="form-group"><label>Name *</label><input type="text" name="nombre" placeholder="Your full name" required/></div><div class="form-group"><label>Phone</label><input type="tel" name="telefono" placeholder="(702) 000-0000"/></div></div>
      <div class="form-group"><label>Email *</label><input type="email" name="email" placeholder="you@email.com" required/></div>
      <div class="form-group"><label>Service of Interest</label><select name="servicio"><option value="">Select a service...</option><option>Tax Preparation</option><option>Bookkeeping</option><option>Payroll</option><option>LLC Formation</option><option>IRS Letters</option><option>Other</option></select></div>
      <div class="form-group"><label>Message *</label><textarea name="mensaje" placeholder="Tell us how we can help you..." required></textarea></div>
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">Send Message</button>
      <p class="form-disclaimer">We do not respond to unsolicited emails. Any spam message will be treated as such.</p>
    </form>
  </div></div>
</div></div></section>
</Layout>
